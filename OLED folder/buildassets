import re, hashlib
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
REPO_ROOT = SCRIPT_DIR.parent
RAW_DIR = SCRIPT_DIR / "Animations OLED"
OUT_PATH = REPO_ROOT / "tamagotchi_eyes" / "anim_assets.h"

SOURCES = {
    'blink': RAW_DIR / "Blinking" / "animation.h",
    'look': RAW_DIR / "Looking" / "animation.h",
    'wink': RAW_DIR / "Winking" / "animation.h",
    'aff': RAW_DIR / "Affectionate" / "animation.h",
    'aff1': RAW_DIR / "Affectionate1" / "animation.h",
    'music': RAW_DIR / "Music" / "animation.h",
    'melody': RAW_DIR / "Melody" / "animation.h",
}

W, H = 128, 64
ROW_BYTES = W // 8
FRAME_BYTES = 1024
FRAME_DELAY = 125

def parse_frames(path):
    if not path.exists():
        raise FileNotFoundError(
            f"Missing source animation file: {path}\n"
            f"check sources to match folder/file name"
        )
    text = path.read_text(errors='ignore')
    m = re.search(r'anim_frames\[\d+\]\[\d+\]\s*=\s*\{(.*)\};', text, re.S)

    if not m:
        raise ValueError(f"Failed to parse frames from {path}")
    body = m.group(1)
    frame_blocks = re.findall(r'\{([^{}]*)\}', body)
    return[bytes(int(x, 16) for x in re.findall(r'0x[0-9A-Fa-f]{2}', fb))
           for fb in frame_blocks]

def xbm_rowmajor_to_ssd1306_pagemajor(frame):
    out = bytearray(FRAME_BYTES)
    for y in range(H):
        row_off = y * ROW_BYTES
        for x in range(W):
            src_byte = frame[row_off + (x >> 3)]
            if (src_byte >> (7- (x & 7))) & 1:
                out[x + (y >> 3) * W] |= (1 << (y & 7))
    return bytes(out)

def skip_run_rle(data):
    out = bytearray()
    i, n = 0, len(data)
    while i < n:
        skip = 0
        while i < n and data[i] == 0 and skip < 255:
            skip += 1; i +=1
        run = bytearray()
        while i < n and data[i] != 0 and len(run) < 255:\
            run.append(data[i]); i += 1
        out.append(skip); out.append(len(run)); out.extend(run)
    return bytes(out)

def main():
    unique_pool = []
    unique_lookup = {}
    all_seqs = {}

    for name, path in SOURCES.items():
        seq = []
        for f in parse_frames(path):
            page = xbm_rowmajor_to_ssd1306_pagemajor(f)
            h = hashlib.md5(page).digest()
            if h not in unique_lookup:
                unique_lookup[h] = len(unique_pool)
                unique_pool.append(skip_run_rle(page))
            seq.append(unique_lookup[h])
        all_seqs[name] = seq

    total_rle = sum(len(u) for u in unique_pool)
    print(f"Unique frames: {len(unique_pool)} (from {sum(len(s) for s in all_seqs.values())} total)")
    print(f"Total RLE PROGMEM bytes: {total_rle}")
 
    OUT_PATH.parent.mkdir(parents=True, exist_ok=True)
    with open(OUT_PATH, 'w') as f:
        f.write("// AUTO-GENERATED by OLED folder/buildassets.py -- do not hand-edit.\n")
        f.write("// Re-run the script if you add/change source animation folders.\n")
        f.write("#pragma once\n#include <avr/pgmspace.h>\n\n")
        f.write(f"#define ANIM_FRAME_BYTES   {FRAME_BYTES}\n")
        f.write(f"#define ANIM_FRAME_DELAY {FRAME_DELAY}\n")
        f.write(f"#define ANIM_UNIQUE_COUNT  {len(unique_pool)}\n\n")
 
        for i, rle in enumerate(unique_pool):
            hexbytes = ", ".join(f"0x{b:02X}" for b in rle)
            f.write(f"const uint8_t PROGMEM anim_u{i:03d}[] = {{ {hexbytes} }};\n")
        f.write("\nconst uint8_t* const PROGMEM anim_unique[ANIM_UNIQUE_COUNT] = {\n  ")
        f.write(", ".join(f"anim_u{i:03d}" for i in range(len(unique_pool))))
        f.write("\n};\n\n")
 
        for name, seq in all_seqs.items():
            f.write(f"const uint8_t PROGMEM {name}_seq[] = {{ {', '.join(map(str, seq))} }};\n")
            f.write(f"#define {name.upper()}_SEQ_LEN {len(seq)}\n\n")
 
    print("Wrote", OUT_PATH)
 
if __name__ == "__main__":
    main()